//! Directory extensions and the collected runtime view.

import component::ComponentDeclaration
import health::HealthNode
import health::HealthStatus
import value::ValueDefinition
import value::ValueObservation

/// Additional absolute directory paths supplied by packages or administrators.
/// Whole `*` path segments match real directories in lexical order on each load.
/// Explicit path segments may follow symlinks; `..` and partial wildcards are invalid.
record DirectoryConfig {
    /// Additional component declaration directories.
    components?: [string],
    /// Additional health definition directories.
    health_nodes?: [string],
    /// Additional health status directories.
    health_statuses?: [string],
    /// Additional value definition directories.
    values?: [string],
    /// Additional value observation directories.
    value_observations?: [string],
}

/// Complete collection loaded from a filesystem or supplied directly.
record RuntimeSnapshot {
    /// Component declarations.
    components: [ComponentDeclaration],
    /// Health definitions.
    health_nodes: [HealthNode],
    /// Published health status records.
    health_statuses: [HealthStatus],
    /// Numeric value definitions.
    values?: [ValueDefinition],
    /// Published value observations.
    value_observations?: [ValueObservation],
}
