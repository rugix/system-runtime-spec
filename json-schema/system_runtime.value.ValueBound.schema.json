{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.value.ValueBound",
  "type": "object",
  "description": "One endpoint of a numeric range, in the referenced value's unit.",
  "properties": {
    "value": {
      "type": [
        "number",
        "string"
      ],
      "pattern": "^(NaN|[+-]?Infinity)$"
    },
    "inclusive": {
      "type": "boolean"
    }
  },
  "required": [
    "value",
    "inclusive"
  ],
  "unevaluatedProperties": false
}