{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.filesystem.RuntimeSnapshot",
  "type": "object",
  "description": "Complete collection loaded from a filesystem or supplied directly.",
  "properties": {
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.component.ComponentDeclaration"
      }
    },
    "healthNodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.health.HealthNode"
      }
    },
    "healthStatuses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.health.HealthStatus"
      }
    }
  },
  "required": [
    "components",
    "healthNodes",
    "healthStatuses"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "system_runtime.component.CapabilityDeclaration": {
      "type": "object",
      "description": "A fact supplied by a component.",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.component.CapabilitySelectorDeclaration": {
      "type": "object",
      "description": "A selector over provided capabilities.",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.component.ClaimDeclaration": {
      "type": "object",
      "description": "An exclusive resource key.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.component.ComponentDeclaration": {
      "type": "object",
      "description": "A participant in a system composition.",
      "properties": {
        "id": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "provides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system_runtime.component.CapabilityDeclaration"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system_runtime.component.ClaimDeclaration"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system_runtime.component.CapabilitySelectorDeclaration"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system_runtime.component.CapabilitySelectorDeclaration"
          }
        }
      },
      "required": [
        "id"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.health.HealthNode": {
      "type": "object",
      "description": "A health check or function in a directed acyclic graph.",
      "properties": {
        "id": {
          "$ref": "#/$defs/system_runtime.health.HealthNodeId"
        },
        "origin": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule": {
          "$ref": "#/$defs/system_runtime.health.HealthRule"
        }
      },
      "required": [
        "id",
        "rule"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.health.HealthNodeId": {
      "type": "string",
      "description": "Identifier of a health graph node, serialized as a string."
    },
    "system_runtime.health.HealthRule": {
      "description": "Definition of an observed or aggregate node.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "rule": {
              "const": "observed"
            },
            "maxAgeMs": {
              "type": "integer",
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 0
            },
            "expectedTag": {
              "type": "string"
            }
          },
          "required": [
            "rule"
          ]
        },
        {
          "type": "object",
          "properties": {
            "rule": {
              "const": "aggregate"
            },
            "inputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/system_runtime.health.HealthNodeId"
              }
            },
            "required": {
              "type": "integer",
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 0
            },
            "healthy": {
              "type": "integer",
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 0
            }
          },
          "required": [
            "rule",
            "inputs",
            "required",
            "healthy"
          ]
        }
      ]
    },
    "system_runtime.health.HealthState": {
      "enum": [
        "healthy",
        "degraded",
        "unhealthy",
        "unknown"
      ],
      "description": "Health relative to a node's declared expectations."
    },
    "system_runtime.health.HealthStatus": {
      "type": "object",
      "description": "Reported status of one observed node within a boot.",
      "properties": {
        "id": {
          "$ref": "#/$defs/system_runtime.health.HealthNodeId"
        },
        "origin": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/system_runtime.health.HealthState"
        },
        "bootId": {
          "type": "string"
        },
        "observedAtMs": {
          "type": [
            "integer",
            "string"
          ],
          "format": "uint64",
          "minimum": 0,
          "pattern": "^[0-9]+$"
        },
        "maxAgeMs": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        },
        "tag": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "state",
        "bootId",
        "observedAtMs",
        "maxAgeMs"
      ],
      "unevaluatedProperties": false
    }
  }
}