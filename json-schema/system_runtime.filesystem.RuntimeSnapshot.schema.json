{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.filesystem.RuntimeSnapshot",
  "type": "object",
  "description": "Records read from a system, for sending them to another system.\n\nAn omitted list means that the snapshot does not include records of its kind. The lists of the\nhealth part are either all present or all omitted.",
  "properties": {
    "specVersion": {
      "type": "string"
    },
    "clock": {
      "$ref": "#/$defs/system_runtime.health.HealthClockSample"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.component.ComponentDeclaration"
      }
    },
    "healthNodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.health.HealthNode"
      }
    },
    "healthStatuses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.health.HealthStatus"
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.metric.MetricDefinition"
      }
    },
    "metricSamples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.metric.MetricSample"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.common.Diagnostic"
      }
    }
  },
  "required": [
    "specVersion",
    "clock"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "system_runtime.common.Diagnostic": {
      "type": "object",
      "description": "A record that was skipped or used despite a problem.",
      "properties": {
        "severity": {
          "$ref": "#/$defs/system_runtime.common.Severity"
        },
        "kind": {
          "$ref": "#/$defs/system_runtime.common.RecordKind"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "severity",
        "kind",
        "message"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.common.RecordKind": {
      "enum": [
        "ComponentDeclaration",
        "HealthNode",
        "HealthStatus",
        "MetricDefinition",
        "MetricSample",
        "DirectoryConfig"
      ],
      "description": "Kind of records, named after the record types."
    },
    "system_runtime.common.Severity": {
      "enum": [
        "Error",
        "Warning"
      ],
      "description": "Effect of a diagnostic on the results."
    },
    "system_runtime.component.CapabilityDeclaration": {
      "type": "object",
      "description": "A fact that a component provides.",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.component.CapabilitySelectorDeclaration": {
      "type": "object",
      "description": "A selector over capabilities.",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.component.ClaimDeclaration": {
      "type": "object",
      "description": "A resource that at most one component may claim.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.component.ComponentDeclaration": {
      "type": "object",
      "description": "One part of a system, such as the system image, an app, a runtime, or a hardware module.",
      "properties": {
        "specVersion": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "provides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system_runtime.component.CapabilityDeclaration"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system_runtime.component.ClaimDeclaration"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system_runtime.component.CapabilitySelectorDeclaration"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system_runtime.component.CapabilitySelectorDeclaration"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "id"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.health.AggregationInput": {
      "type": "object",
      "description": "One input of an aggregate node.",
      "properties": {
        "node": {
          "$ref": "#/$defs/system_runtime.health.HealthNodeId"
        },
        "mode": {
          "$ref": "#/$defs/system_runtime.health.InputMode"
        }
      },
      "required": [
        "node"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.health.Attachment": {
      "type": "object",
      "description": "Attachment of a node to an aggregate node as an input.",
      "properties": {
        "node": {
          "$ref": "#/$defs/system_runtime.health.HealthNodeId"
        },
        "mode": {
          "$ref": "#/$defs/system_runtime.health.InputMode"
        }
      },
      "required": [
        "node"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.health.HealthClockSample": {
      "type": "object",
      "description": "Correlation of the boot-time clock with wall-clock time.",
      "properties": {
        "context": {
          "$ref": "#/$defs/system_runtime.health.HealthContext"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "context",
        "timestamp"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.health.HealthContext": {
      "type": "object",
      "description": "Boot and time in which evidence is evaluated.",
      "properties": {
        "bootId": {
          "type": "string"
        },
        "nowMs": {
          "type": [
            "integer",
            "string"
          ],
          "format": "uint64",
          "minimum": 0,
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "bootId",
        "nowMs"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.health.HealthNode": {
      "type": "object",
      "description": "A check or function whose health is evaluated.",
      "properties": {
        "specVersion": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/system_runtime.health.HealthNodeId"
        },
        "owner": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule": {
          "$ref": "#/$defs/system_runtime.health.HealthRule"
        },
        "partOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system_runtime.health.Attachment"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "id"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.health.HealthNodeId": {
      "type": "string",
      "description": "ID of a health node."
    },
    "system_runtime.health.HealthRule": {
      "description": "How a node's answers are determined.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "Observed"
            },
            "maxAgeMs": {
              "type": [
                "integer",
                "string"
              ],
              "format": "uint64",
              "minimum": 0,
              "pattern": "^[0-9]+$"
            },
            "expectedTag": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "Threshold"
            },
            "metric": {
              "$ref": "#/$defs/system_runtime.metric.MetricId"
            },
            "unit": {
              "type": "string"
            },
            "healthy": {
              "$ref": "#/$defs/system_runtime.metric.MetricRange"
            },
            "usable": {
              "$ref": "#/$defs/system_runtime.metric.MetricRange"
            },
            "maxAgeMs": {
              "type": [
                "integer",
                "string"
              ],
              "format": "uint64",
              "minimum": 0,
              "pattern": "^[0-9]+$"
            }
          },
          "required": [
            "type",
            "metric",
            "healthy",
            "usable"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "Aggregate"
            },
            "inputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/system_runtime.health.AggregationInput"
              }
            },
            "minUsable": {
              "type": [
                "integer",
                "string"
              ],
              "format": "uint64",
              "minimum": 0,
              "pattern": "^[0-9]+$"
            },
            "minHealthy": {
              "type": [
                "integer",
                "string"
              ],
              "format": "uint64",
              "minimum": 0,
              "pattern": "^[0-9]+$"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "system_runtime.health.HealthState": {
      "enum": [
        "Healthy",
        "Degraded",
        "Unhealthy",
        "Unknown"
      ],
      "description": "Summary of the answers of a node."
    },
    "system_runtime.health.HealthStatus": {
      "type": "object",
      "description": "Result of a check, published while the system runs.",
      "properties": {
        "specVersion": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/system_runtime.health.HealthNodeId"
        },
        "state": {
          "$ref": "#/$defs/system_runtime.health.HealthState"
        },
        "bootId": {
          "type": "string"
        },
        "observedAtMs": {
          "type": [
            "integer",
            "string"
          ],
          "format": "uint64",
          "minimum": 0,
          "pattern": "^[0-9]+$"
        },
        "maxAgeMs": {
          "type": [
            "integer",
            "string"
          ],
          "format": "uint64",
          "minimum": 0,
          "pattern": "^[0-9]+$"
        },
        "owner": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": {}
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "state",
        "bootId",
        "observedAtMs",
        "maxAgeMs"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.health.InputMode": {
      "enum": [
        "Counted",
        "Mandatory",
        "Optional"
      ],
      "description": "How an input affects the answers of an aggregate node."
    },
    "system_runtime.metric.MetricBound": {
      "type": "object",
      "description": "One bound of a range, in the metric's unit.",
      "properties": {
        "value": {
          "type": [
            "number",
            "string"
          ],
          "pattern": "^(NaN|[+-]?Infinity)$"
        },
        "inclusive": {
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "inclusive"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.metric.MetricDefinition": {
      "type": "object",
      "description": "A named numeric measurement.",
      "properties": {
        "specVersion": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/system_runtime.metric.MetricId"
        },
        "owner": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unit": {
          "type": "string"
        },
        "maxAgeMs": {
          "type": [
            "integer",
            "string"
          ],
          "format": "uint64",
          "minimum": 0,
          "pattern": "^[0-9]+$"
        },
        "expectedTag": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "unit"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.metric.MetricId": {
      "type": "string",
      "description": "ID of a metric."
    },
    "system_runtime.metric.MetricRange": {
      "type": "object",
      "description": "A non-empty range; a missing bound leaves the range unbounded on that side.",
      "properties": {
        "lower": {
          "$ref": "#/$defs/system_runtime.metric.MetricBound"
        },
        "upper": {
          "$ref": "#/$defs/system_runtime.metric.MetricBound"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "system_runtime.metric.MetricSample": {
      "type": "object",
      "description": "Current measurement of a metric, published while the system runs.",
      "properties": {
        "specVersion": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/system_runtime.metric.MetricId"
        },
        "value": {
          "type": [
            "number",
            "string"
          ],
          "pattern": "^(NaN|[+-]?Infinity)$"
        },
        "bootId": {
          "type": "string"
        },
        "observedAtMs": {
          "type": [
            "integer",
            "string"
          ],
          "format": "uint64",
          "minimum": 0,
          "pattern": "^[0-9]+$"
        },
        "maxAgeMs": {
          "type": [
            "integer",
            "string"
          ],
          "format": "uint64",
          "minimum": 0,
          "pattern": "^[0-9]+$"
        },
        "owner": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": {}
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "value",
        "bootId",
        "observedAtMs",
        "maxAgeMs"
      ],
      "unevaluatedProperties": false
    }
  }
}