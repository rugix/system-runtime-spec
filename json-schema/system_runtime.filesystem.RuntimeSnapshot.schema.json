{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.filesystem.RuntimeSnapshot",
  "type": "object",
  "description": "Complete collection loaded from a filesystem or supplied directly.",
  "properties": {
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.component.ComponentDeclaration"
      }
    },
    "healthNodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.health.HealthNode"
      }
    },
    "healthStatuses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.health.HealthStatus"
      }
    },
    "values": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.value.ValueDefinition"
      }
    },
    "valueObservations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.value.ValueObservation"
      }
    }
  },
  "required": [
    "components",
    "healthNodes",
    "healthStatuses"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "system_runtime.component.CapabilityDeclaration": {
      "type": "object",
      "description": "A fact supplied by a component.",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.component.CapabilitySelectorDeclaration": {
      "type": "object",
      "description": "A selector over provided capabilities.",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.component.ClaimDeclaration": {
      "type": "object",
      "description": "An exclusive resource key.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.component.ComponentDeclaration": {
      "type": "object",
      "description": "A participant in a system composition.",
      "properties": {
        "id": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "provides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system_runtime.component.CapabilityDeclaration"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system_runtime.component.ClaimDeclaration"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system_runtime.component.CapabilitySelectorDeclaration"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system_runtime.component.CapabilitySelectorDeclaration"
          }
        }
      },
      "required": [
        "id"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.health.AggregationInput": {
      "type": "object",
      "description": "One dependency of an aggregate health node.",
      "properties": {
        "node": {
          "$ref": "#/$defs/system_runtime.health.HealthNodeId"
        },
        "required": {
          "type": "boolean"
        },
        "optional": {
          "type": "boolean"
        }
      },
      "required": [
        "node"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.health.HealthNode": {
      "type": "object",
      "description": "A health check or function in a directed acyclic graph.",
      "properties": {
        "id": {
          "$ref": "#/$defs/system_runtime.health.HealthNodeId"
        },
        "owner": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule": {
          "$ref": "#/$defs/system_runtime.health.HealthRule"
        }
      },
      "required": [
        "id",
        "rule"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.health.HealthNodeId": {
      "type": "string",
      "description": "Identifier of a health graph node, serialized as a string."
    },
    "system_runtime.health.HealthRule": {
      "description": "Definition of an observed, threshold, or aggregate node.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "observed"
            },
            "maxAgeMs": {
              "type": "integer",
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 0
            },
            "expectedTag": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "threshold"
            },
            "value": {
              "$ref": "#/$defs/system_runtime.value.ValueId"
            },
            "healthy": {
              "$ref": "#/$defs/system_runtime.value.ValueRange"
            },
            "usable": {
              "$ref": "#/$defs/system_runtime.value.ValueRange"
            },
            "maxAgeMs": {
              "type": "integer",
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 0
            }
          },
          "required": [
            "type",
            "value",
            "healthy",
            "usable"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "aggregate"
            },
            "inputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/system_runtime.health.AggregationInput"
              }
            },
            "required": {
              "type": "integer",
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 0
            },
            "healthy": {
              "type": "integer",
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 0
            }
          },
          "required": [
            "type",
            "inputs"
          ]
        }
      ]
    },
    "system_runtime.health.HealthState": {
      "enum": [
        "healthy",
        "degraded",
        "unhealthy",
        "unknown"
      ],
      "description": "Health relative to a node's declared expectations."
    },
    "system_runtime.health.HealthStatus": {
      "type": "object",
      "description": "Reported status of one observed node within a boot.",
      "properties": {
        "id": {
          "$ref": "#/$defs/system_runtime.health.HealthNodeId"
        },
        "owner": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/system_runtime.health.HealthState"
        },
        "bootId": {
          "type": "string"
        },
        "observedAtMs": {
          "type": [
            "integer",
            "string"
          ],
          "format": "uint64",
          "minimum": 0,
          "pattern": "^[0-9]+$"
        },
        "maxAgeMs": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        },
        "tag": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "state",
        "bootId",
        "observedAtMs",
        "maxAgeMs"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.value.ValueBound": {
      "type": "object",
      "description": "One endpoint of a numeric range, in the referenced value's unit.",
      "properties": {
        "value": {
          "type": [
            "number",
            "string"
          ],
          "pattern": "^(NaN|[+-]?Infinity)$"
        },
        "inclusive": {
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "inclusive"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.value.ValueDefinition": {
      "type": "object",
      "description": "A named measurement, independent of any health policy.",
      "properties": {
        "id": {
          "$ref": "#/$defs/system_runtime.value.ValueId"
        },
        "owner": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unit": {
          "$ref": "#/$defs/system_runtime.value.ValueUnit"
        },
        "maxAgeMs": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        },
        "expectedTag": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "unit"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.value.ValueId": {
      "type": "string",
      "description": "Identifier of a runtime value, unique independently of health node IDs."
    },
    "system_runtime.value.ValueObservation": {
      "type": "object",
      "description": "One measurement within a boot; publishing it does not assert health.",
      "properties": {
        "id": {
          "$ref": "#/$defs/system_runtime.value.ValueId"
        },
        "owner": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "string"
          ],
          "pattern": "^(NaN|[+-]?Infinity)$"
        },
        "bootId": {
          "type": "string"
        },
        "observedAtMs": {
          "type": [
            "integer",
            "string"
          ],
          "format": "uint64",
          "minimum": 0,
          "pattern": "^[0-9]+$"
        },
        "maxAgeMs": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        },
        "tag": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "value",
        "bootId",
        "observedAtMs",
        "maxAgeMs"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.value.ValueRange": {
      "type": "object",
      "description": "A nonempty interval; omitted endpoints are unbounded.",
      "properties": {
        "lower": {
          "$ref": "#/$defs/system_runtime.value.ValueBound"
        },
        "upper": {
          "$ref": "#/$defs/system_runtime.value.ValueBound"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "system_runtime.value.ValueUnit": {
      "enum": [
        "celsius",
        "bytes",
        "seconds",
        "ratio",
        "count",
        "bytes-per-second",
        "hertz",
        "volts",
        "amperes",
        "watts",
        "revolutions-per-minute"
      ],
      "description": "Semantic unit; display prefixes, precision, and conversions are consumer choices."
    }
  }
}