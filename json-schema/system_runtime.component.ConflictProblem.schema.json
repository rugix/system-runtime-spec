{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.component.ConflictProblem",
  "type": "object",
  "description": "A matching conflict.",
  "properties": {
    "component": {
      "type": "string"
    },
    "selector": {
      "$ref": "#/$defs/system_runtime.component.CapabilitySelectorDeclaration"
    },
    "provider": {
      "type": "string"
    },
    "capability": {
      "$ref": "#/$defs/system_runtime.component.CapabilityDeclaration"
    }
  },
  "required": [
    "component",
    "selector",
    "provider",
    "capability"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "system_runtime.component.CapabilityDeclaration": {
      "type": "object",
      "description": "A fact supplied by a component.",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.component.CapabilitySelectorDeclaration": {
      "type": "object",
      "description": "A selector over provided capabilities.",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "unevaluatedProperties": false
    }
  }
}