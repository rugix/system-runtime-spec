{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.health.HealthStatus",
  "type": "object",
  "description": "Result of a check, published while the system runs.",
  "properties": {
    "specVersion": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/system_runtime.health.HealthNodeId"
    },
    "usable": {
      "$ref": "#/$defs/system_runtime.health.Answer"
    },
    "healthy": {
      "$ref": "#/$defs/system_runtime.health.Answer"
    },
    "bootId": {
      "type": "string"
    },
    "observedAtMs": {
      "type": [
        "integer",
        "string"
      ],
      "format": "uint64",
      "minimum": 0,
      "pattern": "^[0-9]+$"
    },
    "maxAgeMs": {
      "type": [
        "integer",
        "string"
      ],
      "format": "uint64",
      "minimum": 0,
      "pattern": "^[0-9]+$"
    },
    "owner": {
      "type": "string"
    },
    "tag": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "details": {
      "type": "object",
      "additionalProperties": {}
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "usable",
    "healthy",
    "bootId",
    "observedAtMs",
    "maxAgeMs"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "system_runtime.health.Answer": {
      "enum": [
        "Yes",
        "No",
        "Unknown"
      ],
      "description": "Answer to whether criteria are met."
    },
    "system_runtime.health.HealthNodeId": {
      "type": "string",
      "description": "ID of a health node."
    }
  }
}