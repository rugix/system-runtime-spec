{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.health.HealthStatus",
  "type": "object",
  "description": "Reported status of one observed node within a boot.",
  "properties": {
    "id": {
      "$ref": "#/$defs/system_runtime.health.HealthNodeId"
    },
    "owner": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/system_runtime.health.HealthState"
    },
    "bootId": {
      "type": "string"
    },
    "observedAtMs": {
      "type": [
        "integer",
        "string"
      ],
      "format": "uint64",
      "minimum": 0,
      "pattern": "^[0-9]+$"
    },
    "maxAgeMs": {
      "type": "integer",
      "format": "uint32",
      "maximum": 4294967295,
      "minimum": 0
    },
    "tag": {
      "type": "string"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "state",
    "bootId",
    "observedAtMs",
    "maxAgeMs"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "system_runtime.health.HealthNodeId": {
      "type": "string",
      "description": "Identifier of a health graph node, serialized as a string."
    },
    "system_runtime.health.HealthState": {
      "enum": [
        "healthy",
        "degraded",
        "unhealthy",
        "unknown"
      ],
      "description": "Health relative to a node's declared expectations."
    }
  }
}