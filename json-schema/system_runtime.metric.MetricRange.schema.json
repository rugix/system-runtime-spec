{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.metric.MetricRange",
  "type": "object",
  "description": "A nonempty interval; omitted endpoints are unbounded.",
  "properties": {
    "lower": {
      "$ref": "#/$defs/system_runtime.metric.MetricBound"
    },
    "upper": {
      "$ref": "#/$defs/system_runtime.metric.MetricBound"
    }
  },
  "required": [],
  "unevaluatedProperties": false,
  "$defs": {
    "system_runtime.metric.MetricBound": {
      "type": "object",
      "description": "One endpoint of a numeric range, in the referenced metric's unit.",
      "properties": {
        "value": {
          "type": [
            "number",
            "string"
          ],
          "pattern": "^(NaN|[+-]?Infinity)$"
        },
        "inclusive": {
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "inclusive"
      ],
      "unevaluatedProperties": false
    }
  }
}