{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.metric.MetricSample",
  "type": "object",
  "description": "Current measurement of a metric, published while the system runs.",
  "properties": {
    "specVersion": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/system_runtime.metric.MetricId"
    },
    "value": {
      "type": [
        "number",
        "string"
      ],
      "pattern": "^(NaN|[+-]?Infinity)$"
    },
    "bootId": {
      "type": "string"
    },
    "observedAtMs": {
      "type": [
        "integer",
        "string"
      ],
      "format": "uint64",
      "minimum": 0,
      "pattern": "^[0-9]+$"
    },
    "maxAgeMs": {
      "type": [
        "integer",
        "string"
      ],
      "format": "uint64",
      "minimum": 0,
      "pattern": "^[0-9]+$"
    },
    "owner": {
      "type": "string"
    },
    "tag": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "value",
    "bootId",
    "observedAtMs",
    "maxAgeMs"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "system_runtime.metric.MetricId": {
      "type": "string",
      "description": "ID of a metric."
    }
  }
}