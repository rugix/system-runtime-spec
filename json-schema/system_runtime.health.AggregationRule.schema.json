{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.health.AggregationRule",
  "type": "object",
  "description": "Inputs of an aggregate node and the counts they need to meet.",
  "properties": {
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.health.AggregationInput"
      }
    },
    "minUsable": {
      "type": [
        "integer",
        "string"
      ],
      "format": "uint64",
      "minimum": 0,
      "pattern": "^[0-9]+$"
    },
    "minHealthy": {
      "type": [
        "integer",
        "string"
      ],
      "format": "uint64",
      "minimum": 0,
      "pattern": "^[0-9]+$"
    }
  },
  "required": [],
  "unevaluatedProperties": false,
  "$defs": {
    "system_runtime.health.AggregationInput": {
      "type": "object",
      "description": "One input of an aggregate node.",
      "properties": {
        "node": {
          "$ref": "#/$defs/system_runtime.health.HealthNodeId"
        },
        "mode": {
          "$ref": "#/$defs/system_runtime.health.InputMode"
        }
      },
      "required": [
        "node"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.health.HealthNodeId": {
      "type": "string",
      "description": "ID of a health node."
    },
    "system_runtime.health.InputMode": {
      "enum": [
        "Counted",
        "Mandatory",
        "Optional"
      ],
      "description": "How an input affects the answers of an aggregate node."
    }
  }
}