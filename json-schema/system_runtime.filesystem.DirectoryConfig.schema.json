    "components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "healthNodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "healthStatuses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "values": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "valueObservations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [],
  "unevaluatedProperties": false
}