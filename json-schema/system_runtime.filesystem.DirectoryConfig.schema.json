      "items": {
        "type": "string"
      }
    },
    "healthStatuses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metricSamples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [],
