  "$id": "system_runtime.filesystem.DirectoryConfig",
  "type": "object",
  "description": "Additional absolute directory paths supplied by packages or administrators.\nWhole `*` path segments match real directories in lexical order on each load.\nExplicit path segments may follow symlinks; `..` and partial wildcards are invalid.",
