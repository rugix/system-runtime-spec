          "problem": {
            "const": "unsatisfiedRequirement"
          },
          "component": {
            "type": "string"
          },
          "selector": {
            "$ref": "#/components/schemas/system_runtime.component.CapabilitySelectorDeclaration"
          }
        },
        "required": [
          "problem",
          "component",
          "selector"
        ]
      },
      {
        "type": "object",
        "properties": {
          "problem": {
            "const": "conflict"
          },
          "component": {
            "type": "string"
          },
          "selector": {
            "$ref": "#/components/schemas/system_runtime.component.CapabilitySelectorDeclaration"
          },
          "provider": {
            "type": "string"
          },
          "capability": {
            "$ref": "#/components/schemas/system_runtime.component.CapabilityDeclaration"
          }
        },
        "required": [
          "problem",
          "component",
          "selector",
          "provider",
          "capability"
        ]
      }
    ]
  },
