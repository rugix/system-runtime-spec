{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.health.HealthRule",
  "description": "Definition of an observed, threshold, or aggregate node.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "observed"
        },
        "maxAgeMs": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        },
        "expectedTag": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "threshold"
        },
        "metric": {
          "$ref": "#/$defs/system_runtime.metric.MetricId"
        },
        "healthy": {
          "$ref": "#/$defs/system_runtime.metric.MetricRange"
        },
        "usable": {
          "$ref": "#/$defs/system_runtime.metric.MetricRange"
        },
        "maxAgeMs": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        }
      },
      "required": [
        "type",
        "metric",
        "healthy",
        "usable"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "aggregate"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system_runtime.health.AggregationInput"
          }
        },
        "required": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        },
        "healthy": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        }
      },
      "required": [
        "type",
        "inputs"
      ]
    }
  ],
  "$defs": {
    "system_runtime.health.AggregationInput": {
      "type": "object",
      "description": "One dependency of an aggregate health node.",
      "properties": {
        "node": {
          "$ref": "#/$defs/system_runtime.health.HealthNodeId"
        },
        "required": {
          "type": "boolean"
        },
        "optional": {
          "type": "boolean"
        }
      },
      "required": [
        "node"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.health.HealthNodeId": {
      "type": "string",
      "description": "Identifier of a health graph node, serialized as a string."
    },
    "system_runtime.metric.MetricBound": {
      "type": "object",
      "description": "One endpoint of a numeric range, in the referenced metric's unit.",
      "properties": {
        "value": {
          "type": [
            "number",
            "string"
          ],
          "pattern": "^(NaN|[+-]?Infinity)$"
        },
        "inclusive": {
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "inclusive"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.metric.MetricId": {
      "type": "string",
      "description": "Identifier of a metric, unique independently of health node IDs."
    },
    "system_runtime.metric.MetricRange": {
      "type": "object",
      "description": "A nonempty interval; omitted endpoints are unbounded.",
      "properties": {
        "lower": {
          "$ref": "#/$defs/system_runtime.metric.MetricBound"
        },
        "upper": {
          "$ref": "#/$defs/system_runtime.metric.MetricBound"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    }
  }
}