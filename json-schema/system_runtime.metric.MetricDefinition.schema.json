{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.metric.MetricDefinition",
  "type": "object",
  "description": "A named numeric measurement.",
  "properties": {
    "specVersion": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/system_runtime.metric.MetricId"
    },
    "owner": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unit": {
      "type": "string"
    },
    "maxAgeMs": {
      "type": [
        "integer",
        "string"
      ],
      "format": "uint64",
      "minimum": 0,
      "pattern": "^[0-9]+$"
    },
    "expectedTag": {
      "type": "string"
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "unit"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "system_runtime.metric.MetricId": {
      "type": "string",
      "description": "ID of a metric."
    }
  }
}