{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.metric.MetricDefinition",
  "type": "object",
  "description": "A named numeric measurement, independent of any health policy; samples carry no history.",
  "properties": {
    "id": {
      "$ref": "#/$defs/system_runtime.metric.MetricId"
    },
    "owner": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unit": {
      "$ref": "#/$defs/system_runtime.metric.MetricUnit"
    },
    "maxAgeMs": {
      "type": "integer",
      "format": "uint32",
      "maximum": 4294967295,
      "minimum": 0
    },
    "expectedTag": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "unit"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "system_runtime.metric.MetricId": {
      "type": "string",
      "description": "Identifier of a metric, unique independently of health node IDs."
    },
    "system_runtime.metric.MetricUnit": {
      "enum": [
        "celsius",
        "bytes",
        "seconds",
        "ratio",
        "count",
        "bytes-per-second",
        "hertz",
        "volts",
        "amperes",
        "watts",
        "revolutions-per-minute"
      ],
      "description": "Semantic unit; display prefixes, precision, and conversions are consumer choices."
    }
  }
}