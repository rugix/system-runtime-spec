{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.health.HealthNode",
  "type": "object",
  "description": "A check or function whose health is evaluated.",
  "properties": {
    "specVersion": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/system_runtime.health.HealthNodeId"
    },
    "owner": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rule": {
      "$ref": "#/$defs/system_runtime.health.HealthRule"
    },
    "partOf": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.health.Attachment"
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "id"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "system_runtime.health.AggregationInput": {
      "type": "object",
      "description": "One input of an aggregate node.",
      "properties": {
        "node": {
          "$ref": "#/$defs/system_runtime.health.HealthNodeId"
        },
        "mode": {
          "$ref": "#/$defs/system_runtime.health.InputMode"
        }
      },
      "required": [
        "node"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.health.Attachment": {
      "type": "object",
      "description": "Attachment of a node to an aggregate node as an input.",
      "properties": {
        "node": {
          "$ref": "#/$defs/system_runtime.health.HealthNodeId"
        },
        "mode": {
          "$ref": "#/$defs/system_runtime.health.InputMode"
        }
      },
      "required": [
        "node"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.health.HealthNodeId": {
      "type": "string",
      "description": "ID of a health node."
    },
    "system_runtime.health.HealthRule": {
      "description": "How a node's answers are determined.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "Observed"
            },
            "maxAgeMs": {
              "type": [
                "integer",
                "string"
              ],
              "format": "uint64",
              "minimum": 0,
              "pattern": "^[0-9]+$"
            },
            "expectedTag": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "Threshold"
            },
            "metric": {
              "$ref": "#/$defs/system_runtime.metric.MetricId"
            },
            "unit": {
              "type": "string"
            },
            "healthy": {
              "$ref": "#/$defs/system_runtime.metric.MetricRange"
            },
            "usable": {
              "$ref": "#/$defs/system_runtime.metric.MetricRange"
            },
            "maxAgeMs": {
              "type": [
                "integer",
                "string"
              ],
              "format": "uint64",
              "minimum": 0,
              "pattern": "^[0-9]+$"
            }
          },
          "required": [
            "type",
            "metric",
            "healthy",
            "usable"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "Aggregate"
            },
            "inputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/system_runtime.health.AggregationInput"
              }
            },
            "minUsable": {
              "type": [
                "integer",
                "string"
              ],
              "format": "uint64",
              "minimum": 0,
              "pattern": "^[0-9]+$"
            },
            "minHealthy": {
              "type": [
                "integer",
                "string"
              ],
              "format": "uint64",
              "minimum": 0,
              "pattern": "^[0-9]+$"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "system_runtime.health.InputMode": {
      "enum": [
        "Counted",
        "Mandatory",
        "Optional"
      ],
      "description": "How an input affects the answers of an aggregate node."
    },
    "system_runtime.metric.MetricBound": {
      "type": "object",
      "description": "One bound of a range, in the metric's unit.",
      "properties": {
        "value": {
          "type": [
            "number",
            "string"
          ],
          "pattern": "^(NaN|[+-]?Infinity)$"
        },
        "inclusive": {
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "inclusive"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.metric.MetricId": {
      "type": "string",
      "description": "ID of a metric."
    },
    "system_runtime.metric.MetricRange": {
      "type": "object",
      "description": "A non-empty range; a missing bound leaves the range unbounded on that side.",
      "properties": {
        "lower": {
          "$ref": "#/$defs/system_runtime.metric.MetricBound"
        },
        "upper": {
          "$ref": "#/$defs/system_runtime.metric.MetricBound"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    }
  }
}