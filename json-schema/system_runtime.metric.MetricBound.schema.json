{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.metric.MetricBound",
  "type": "object",
  "description": "One bound of a range, in the metric's unit.",
  "properties": {
    "value": {
      "type": [
        "number",
        "string"
      ],
      "pattern": "^(NaN|[+-]?Infinity)$"
    },
    "inclusive": {
      "type": "boolean"
    }
  },
  "required": [
    "value",
    "inclusive"
  ],
  "unevaluatedProperties": false
}