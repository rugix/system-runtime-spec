{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.component.ComponentDeclaration",
  "type": "object",
  "description": "One part of a system, such as the system image, an app, a runtime, or a hardware module.",
  "properties": {
    "specVersion": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "provides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.component.CapabilityDeclaration"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.component.ClaimDeclaration"
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.component.CapabilitySelectorDeclaration"
      }
    },
    "conflicts": {
      "type": "array",
