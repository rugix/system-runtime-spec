{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.component.ComponentDeclaration",
  "type": "object",
  "description": "A participant in a system composition.",
  "properties": {
    "id": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "provides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.component.CapabilityDeclaration"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.component.ClaimDeclaration"
      }
    },
    "requires": {
      "type": "array",
