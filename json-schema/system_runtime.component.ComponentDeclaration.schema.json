      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.component.ClaimDeclaration": {
      "type": "object",
