{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.component.SelectorProblem",
  "type": "object",
  "description": "A requirement that matches no capability.",
  "properties": {
    "component": {
      "type": "string"
    },
    "selector": {
      "$ref": "#/$defs/system_runtime.component.CapabilitySelectorDeclaration"
    }
  },
  "required": [
    "component",
    "selector"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "system_runtime.component.CapabilitySelectorDeclaration": {
      "type": "object",
      "description": "A selector over capabilities.",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "unevaluatedProperties": false
    }
  }
}