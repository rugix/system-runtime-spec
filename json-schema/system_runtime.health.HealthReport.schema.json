{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.health.HealthReport",
  "type": "object",
  "description": "Evaluated graph, in declaration order.",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.health.HealthNodeResult"
      }
    }
  },
  "required": [
    "nodes"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "system_runtime.health.HealthNodeId": {
      "type": "string",
      "description": "Identifier of a health graph node, serialized as a string."
    },
    "system_runtime.health.HealthNodeResult": {
      "type": "object",
      "description": "Evaluated state and evidence for a node.",
      "properties": {
        "id": {
          "$ref": "#/$defs/system_runtime.health.HealthNodeId"
        },
        "owner": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/system_runtime.health.HealthState"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system_runtime.health.HealthNodeId"
          }
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "state",
        "inputs"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.health.HealthState": {
      "enum": [
        "healthy",
        "degraded",
        "unhealthy",
        "unknown"
      ],
      "description": "Health relative to a node's declared expectations."
    }
  }
}