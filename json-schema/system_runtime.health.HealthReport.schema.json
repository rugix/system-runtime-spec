{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.health.HealthReport",
  "type": "object",
  "description": "Result of evaluating health.",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.health.HealthNodeResult"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.common.Diagnostic"
      }
    }
  },
  "required": [
    "nodes",
    "diagnostics"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "system_runtime.common.Diagnostic": {
      "type": "object",
      "description": "A record that was skipped or used despite a problem.",
      "properties": {
        "severity": {
          "$ref": "#/$defs/system_runtime.common.Severity"
        },
        "kind": {
          "$ref": "#/$defs/system_runtime.common.RecordKind"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "severity",
        "kind",
        "message"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.common.RecordKind": {
      "enum": [
        "ComponentDeclaration",
        "HealthNode",
        "HealthStatus",
        "MetricDefinition",
        "MetricSample",
        "DirectoryConfig"
      ],
      "description": "Kind of records, named after the record types."
    },
    "system_runtime.common.Severity": {
      "enum": [
        "Error",
        "Warning"
      ],
      "description": "Effect of a diagnostic on the results."
    },
    "system_runtime.health.Answer": {
      "enum": [
        "Yes",
        "No",
        "Unknown"
      ],
      "description": "Answer to whether criteria are met."
    },
    "system_runtime.health.HealthNodeId": {
      "type": "string",
      "description": "ID of a health node."
    },
    "system_runtime.health.HealthNodeResult": {
      "type": "object",
      "description": "Answers of one node.",
      "properties": {
        "id": {
          "$ref": "#/$defs/system_runtime.health.HealthNodeId"
        },
        "owner": {
          "type": "string"
        },
        "usable": {
          "$ref": "#/$defs/system_runtime.health.Answer"
        },
        "healthy": {
          "$ref": "#/$defs/system_runtime.health.Answer"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system_runtime.health.HealthNodeId"
          }
        },
        "reason": {
          "$ref": "#/$defs/system_runtime.health.Reason"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "usable",
        "healthy",
        "inputs"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.health.Reason": {
      "enum": [
        "Missing",
        "OtherBoot",
        "OwnerMismatch",
        "TagMismatch",
        "Future",
        "Expired",
        "Conflict",
        "Cycle",
        "Unsupported"
      ],
      "description": "Why a node's evidence was not used or its rule was not applied."
    }
  }
}