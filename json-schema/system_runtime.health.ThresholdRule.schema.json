{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.health.ThresholdRule",
  "type": "object",
  "description": "Ranges that a metric sample is compared with.",
  "properties": {
    "metric": {
      "$ref": "#/$defs/system_runtime.metric.MetricId"
    },
    "unit": {
      "type": "string"
    },
    "healthy": {
      "$ref": "#/$defs/system_runtime.metric.MetricRange"
    },
    "usable": {
      "$ref": "#/$defs/system_runtime.metric.MetricRange"
    },
    "maxAgeMs": {
      "type": [
        "integer",
        "string"
      ],
      "format": "uint64",
      "minimum": 0,
      "pattern": "^[0-9]+$"
    }
  },
  "required": [
    "metric",
    "healthy",
    "usable"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "system_runtime.metric.MetricBound": {
      "type": "object",
      "description": "One bound of a range, in the metric's unit.",
      "properties": {
        "value": {
          "type": [
            "number",
            "string"
          ],
          "pattern": "^(NaN|[+-]?Infinity)$"
        },
        "inclusive": {
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "inclusive"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.metric.MetricId": {
      "type": "string",
      "description": "ID of a metric."
    },
    "system_runtime.metric.MetricRange": {
      "type": "object",
      "description": "A non-empty range; a missing bound leaves the range unbounded on that side.",
      "properties": {
        "lower": {
          "$ref": "#/$defs/system_runtime.metric.MetricBound"
        },
        "upper": {
          "$ref": "#/$defs/system_runtime.metric.MetricBound"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    }
  }
}