{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system_runtime.component.CompatibilityReport",
  "type": "object",
  "description": "Result of checking a composition.",
  "properties": {
    "consistent": {
      "type": "boolean"
    },
    "problems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.component.CompatibilityProblem"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_runtime.common.Diagnostic"
      }
    }
  },
  "required": [
    "consistent",
    "problems",
    "diagnostics"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "system_runtime.common.Diagnostic": {
      "type": "object",
      "description": "A record that was skipped or used despite a problem.",
      "properties": {
        "severity": {
          "$ref": "#/$defs/system_runtime.common.Severity"
        },
        "kind": {
          "$ref": "#/$defs/system_runtime.common.DiagnosticKind"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "severity",
        "kind",
        "message"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.common.DiagnosticKind": {
      "enum": [
        "ComponentDeclaration",
        "HealthNode",
        "HealthStatus",
        "MetricDefinition",
        "MetricSample",
        "DirectoryConfig"
      ],
      "description": "Kind of the files that a diagnostic concerns, named after their types."
    },
    "system_runtime.common.Severity": {
      "enum": [
        "Error",
        "Warning"
      ],
      "description": "Effect of a diagnostic on the results."
    },
    "system_runtime.component.CapabilityDeclaration": {
      "type": "object",
      "description": "A fact that a component provides.",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.component.CapabilitySelectorDeclaration": {
      "type": "object",
      "description": "A selector over capabilities.",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "unevaluatedProperties": false
    },
    "system_runtime.component.CompatibilityProblem": {
      "description": "A violated constraint.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "problem": {
              "const": "DuplicateComponent"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "problem",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "problem": {
              "const": "DuplicateClaim"
            },
            "id": {
              "type": "string"
            },
            "components": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "problem",
            "id",
            "components"
          ]
        },
        {
          "type": "object",
          "properties": {
            "problem": {
              "const": "UnsatisfiedRequirement"
            },
            "component": {
              "type": "string"
            },
            "selector": {
              "$ref": "#/$defs/system_runtime.component.CapabilitySelectorDeclaration"
            }
          },
          "required": [
            "problem",
            "component",
            "selector"
          ]
        },
        {
          "type": "object",
          "properties": {
            "problem": {
              "const": "Conflict"
            },
            "component": {
              "type": "string"
            },
            "selector": {
              "$ref": "#/$defs/system_runtime.component.CapabilitySelectorDeclaration"
            },
            "provider": {
              "type": "string"
            },
            "capability": {
              "$ref": "#/$defs/system_runtime.component.CapabilityDeclaration"
            }
          },
          "required": [
            "problem",
            "component",
            "selector",
            "provider",
            "capability"
          ]
        }
      ]
    }
  }
}